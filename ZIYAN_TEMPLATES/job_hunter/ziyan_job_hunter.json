{
  "name": "ZIYAN Job Hunter (9router + JSearch)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }] } },
      "name": "Schedule (08:00 harian)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "keywords", "type": "string", "value": "remote data analyst indonesia" },
            { "id": "2", "name": "location", "type": "string", "value": "Indonesia" },
            { "id": "3", "name": "max", "type": "number", "value": 20 }
          ]
        }
      },
      "name": "Config Pencarian",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [220, 300]
    },
    {
      "parameters": {
        "url": "=https://jsearch.p.rapidapi.com/search",
        "options": { "queryParameters": { "parameters": [
          { "name": "query", "value": "={{ $json.keywords }} in {{ $json.location }}" },
          { "name": "num_pages", "value": "1" },
          { "name": "country", "value": "id" }
        ]}},
        "headers": { "parameters": [
          { "name": "X-RapidAPI-Key", "value": "={{ $env.RAPIDAPI_KEY }}" },
          { "name": "X-RapidAPI-Host", "value": "jsearch.p.rapidapi.com" }
        ]},
        "method": "GET"
      },
      "name": "Fetch Jobs (JSearch API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "functionCode": "const jobs = $input.all()[0].json.data || [];\nreturn jobs.slice(0, $vars.max || 20).map(j => ({\n  title: j.job_title,\n  company: j.employer_name,\n  location: j.job_city || j.job_country,\n  link: j.job_apply_link,\n  desc: (j.job_description||'').slice(0,800)\n}));"
      },
      "name": "Parse Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "url": "=https://9router.noes.chat/v1/chat/completions",
        "options": { "queryParameters": { "parameters": [
          { "name": "model", "value": "openrouter/auto" }
        ]}},
        "headers": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $env.HERMES_CUSTOM_9ROUTER_API_KEY }}" },
          { "name": "Content-Type", "value": "application/json" }
        ]},
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messages\": [\n    {\"role\":\"system\",\"content\":\"Kamu AI Scorer lowongan. Nilai kecocokan job vs profil user (remote data analyst Indonesia) 0-100. Balas JSON: {\\\"score\\\":int,\\\"alasan\\\":string,\\\"cocok\\\":bool}\"},\n    {\"role\":\"user\",\"content\":\"JOB: {{ $json.title }} - {{ $json.company }} - {{ $json.desc }}\"}\n  ]\n}",
        "responseFormat": "json"
      },
      "name": "AI Score (9router)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true }, "conditions": [
          { "left": "={{ JSON.parse($json.body.choices[0].message.content).score }}", "operator": { "type": "number", "operation": "gte" }, "right": 70 }
        ]}
      },
      "name": "Filter (score>=70)",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔎 *Lowongan Cocok!*\n\n*{{ $json.title }}*\n{{ $json.company }} — {{ $json.location }}\n\nSkor: {{ JSON.parse($node['AI Score (9router)'].json.body.choices[0].message.content).score }}\n{{ $json.link }}"
      },
      "name": "Kirim ke Telegram (Orion)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1320, 300]
    }
  ],
  "connections": {
    "Schedule (08:00 harian)": { "main": [[{ "node": "Config Pencarian", "type": "main", "index": 0 }]] },
    "Config Pencarian": { "main": [[{ "node": "Fetch Jobs (JSearch API)", "type": "main", "index": 0 }]] },
    "Fetch Jobs (JSearch API)": { "main": [[{ "node": "Parse Jobs", "type": "main", "index": 0 }]] },
    "Parse Jobs": { "main": [[{ "node": "AI Score (9router)", "type": "main", "index": 0 }]] },
    "AI Score (9router)": { "main": [[{ "node": "Filter (score>=70)", "type": "main", "index": 0 }]] },
    "Filter (score>=70)": { "main": [[{ "node": "Kirim ke Telegram (Orion)", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}